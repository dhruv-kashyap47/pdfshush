/**
 * pdfshush — the free deployment shape.
 *
 * One Worker script serves the SPA from Static Assets and the API from
 * `apps/edge`. Accounts live in D1. There is no Redis, no Mongo and no
 * server-side PDF worker: every tool runs in the visitor's browser, which is the
 * product's actual claim.
 *
 * Build and deploy:
 *
 *   pnpm --filter @pdfshush/web build
 *   npx wrangler d1 create pdfshush          # once; paste the id below
 *   npx wrangler d1 migrations apply pdfshush --remote
 *   npx wrangler deploy
 *
 * Secrets (never in this file):
 *
 *   npx wrangler secret put GOOGLE_CLIENT_ID
 *   npx wrangler secret put GOOGLE_CLIENT_SECRET
 *   npx wrangler secret put AI_MANAGED_API_KEY      # optional, managed AI
 *   npx wrangler secret put DODO_API_KEY            # optional, billing
 *   npx wrangler secret put DODO_WEBHOOK_SECRET     # optional, billing
 *
 * The scope note this file used to carry ("deploys the frontend only, the
 * Express API stays local") is no longer true. The Express shape still exists in
 * the repository and still runs from `docker-compose.yml`; it is a separate
 * deployment, not this one.
 */
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "pdfshush",
  "compatibility_date": "2026-11-13",

  // The API and the asset router share one script. `nodejs_compat` is
  // deliberately absent: this Worker uses WebCrypto and fetch only, so the
  // polyfill layer would be dead weight on every cold start.
  "main": "./apps/edge/src/index.ts",

  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",

    // The prerender plugin writes flat documents (`dist/trust.html`,
    // `dist/tools/merge-pdf.html`), not `<route>/index.html`. The default
    // "auto-trailing-slash" serves those at the extensionless canonical URLs
    // and redirects `/trust.html` -> `/trust`, so one URL per page survives.
    // "force-trailing-slash" would break every prerendered route.
    "html_handling": "auto-trailing-slash",

    // Client-side routes get `/index.html` with a 200 so the React router can
    // render. API paths never reach this fallback: the Worker splits them off
    // before it consults the asset router, and returns JSON.
    "not_found_handling": "single-page-application",

    // Cloudflare matches these patterns case-sensitively while HTTP servers
    // (including Express) match case-insensitively. All eight spellings of
    // "api" are listed so `/API/health` cannot bypass the split. On the free
    // plan, matching these patterns counts as a Worker invocation and returns
    // 429 over the daily limit instead of falling back to assets — which is the
    // correct failure for an API.
    "run_worker_first": [
      "/api",
      "/api/*",
      "/apI",
      "/apI/*",
      "/aPi",
      "/aPi/*",
      "/aPI",
      "/aPI/*",
      "/Api",
      "/Api/*",
      "/APi",
      "/APi/*",
      "/ApI",
      "/ApI/*",
      "/API",
      "/API/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pdfshush",
      // Replace with the id from `wrangler d1 create pdfshush`. Local dev
      // (`wrangler dev`) works with this placeholder; deploy will not.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./apps/edge/migrations"
    }
  ],

  "vars": {
    "WEB_ORIGIN": "https://pdfshush.com",
    "SESSION_COOKIE_SECURE": "true",

    // Managed AI stays OFF until both a model (here) and a key (secret) exist.
    // That keeps a fresh deploy identical to the pre-AI shape. To turn it on:
    //
    //   npx wrangler secret put AI_MANAGED_API_KEY   # sk-or-v1-...
    //   # then set AI_MANAGED_MODEL below to any OpenRouter model id
    //
    // IMPORTANT: buy 10 credits on OpenRouter once. Below 10 credits its
    // free-model limit is 50 requests/day *for the whole account*; at 10+ it is
    // 1,000/day. The Worker budgets 700 anonymous + 200 Pro out of that.
    "AI_MANAGED_PROVIDER": "openrouter",
    "AI_MANAGED_MODEL": "",
    "AI_MANAGED_MAX_OUTPUT_TOKENS": "4096",

    // Billing. Dodo Payments is the merchant of record, so it owns tax and
    // receipts; this Worker only creates checkouts and verifies webhooks.
    //
    // Product ids are not secrets. An empty id switches that rail off, and with
    // no DODO_API_KEY (a secret) every billing route answers 503. DODO_ENVIRONMENT
    // defaults to "test", so a missing value cannot charge a real card.
    "DODO_ENVIRONMENT": "test",
    "DODO_PRODUCT_SPONSOR_FEATURED": "",
    "DODO_PRODUCT_SPONSOR_STANDARD": "",
    "DODO_PRODUCT_CREDITS": "",
    "DODO_PRODUCT_PASS_30D": "",
    "DODO_PRODUCT_DONATE": ""
  },

  // Session and transaction cleanup. Off the hour so it does not collide with
  // other accounts' midnight cron jobs.
  "triggers": {
    "crons": ["17 * * * *"]
  }
}
