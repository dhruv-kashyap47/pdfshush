{
  "name": "@pdfshush/pdf-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Environment-agnostic PDF engine for PDFShush. Runs identically in a browser Web Worker and a Node worker.",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}