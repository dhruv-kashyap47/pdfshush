# Active configuration for the Cloudflare-only shape.
#
# The SPA uses the committed `apps/web/.env.production` for production builds.
# The Worker reads its non-secret vars from `wrangler.jsonc` and its secrets from
# `wrangler secret put` (or `apps/edge/.dev.vars` locally). Nothing in this file
# is read by the build or the Worker automatically; it is the one-page reference
# for the values you need.
#
# Secrets must never be committed.

# ---------------------------------------------------------------- web --------
# Canonical origin baked into prerendered HTML, sitemap, Open Graph and OAuth.
# Override per deployment with a real environment variable of the same name.
VITE_SITE_ORIGIN=https://pdfshush.com

# `on` builds the Worker-connected shape (accounts, sync, managed AI, sponsor
# cards). `off` is the static-only shape. Production should be `on`.
VITE_SERVER_API=on

# -------------------------------------------------------------- worker -------
# Set in the Cloudflare dashboard or with `wrangler secret put`:
#   GOOGLE_CLIENT_ID
#   GOOGLE_CLIENT_SECRET
#   DODO_API_KEY            (optional; billing stays 503 until set)
#   DODO_WEBHOOK_SECRET     (optional)
#   AI_MANAGED_API_KEY      (optional; managed AI stays off until set)
#
# Non-secret values live in `wrangler.jsonc`:
#   WEB_ORIGIN
#   GOOGLE_REDIRECT_URI
#   AI_MANAGED_PROVIDER=openrouter
#   AI_MANAGED_MODEL=<openrouter model id>
#   DODO_ENVIRONMENT=test
#   DODO_PRODUCT_*=...

# ------------------------------------------------------------- local ---------
# `apps/edge/.dev.vars` (gitignored) mirrors the Worker secrets for
# `pnpm dev:edge`. Copy `apps/edge/.dev.vars.example` and fill it in.
