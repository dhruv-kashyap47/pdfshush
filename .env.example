# PDFShush server configuration.
#
# Copy to `.env` (which is gitignored) and fill in what you need. Every value
# here has a working default, so an empty `.env` boots the API anonymously with
# all 14 client-side tools and 8 server-side jobs, and accounts switched off.

# ---------------------------------------------------------------- core ------

NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# Redis: queue, quota counters and job state. Never the store of record.
REDIS_URL=redis://127.0.0.1:6379

# Where uploads and results live. Must be a real volume in production.
WORK_DIR=.work

# Run the worker in the API process (development convenience; off in production).
# EMBEDDED_WORKER=true
WORKER_CONCURRENCY=2

# Secret that keys quota subjects and job tokens. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Unset means one is generated once and kept on the work volume, so restarts do
# not invalidate job tokens -- but a lost volume resets every quota.
# PEPPER=

# Proxies in front of the API whose X-Forwarded-For you trust: a hop count
# (1, 2, ...) or `true` for exactly one hop. Never leave this unset behind a
# proxy you do not control, or clients can choose their own quota identity.
# TRUST_PROXY=1

# How long job files may sit before the janitor removes them, and how often it
# looks. Defaults: 1 hour / 5 minutes.
# FILE_TTL_MS=3600000
# JANITOR_INTERVAL_MS=300000

# Anonymous quota overrides. Defaults come from LIMITS.server.
# QUOTA_TASKS_PER_DAY=150
# QUOTA_TASKS_PER_MINUTE=6
# MAX_UPLOAD_BYTES=524288000

LOG_LEVEL=info

# ------------------------------------------------------------- accounts -----
#
# Accounts are OFF unless MONGODB_URI and both Google values are set. Every tool
# works without them; they only add saved workflows, synced history and job
# ownership. Leave all four blank to run anonymously.

# MongoDB -- the store of record for account data (not for jobs).
# MONGODB_URI=mongodb+srv://<cluster>/<db>
# MONGODB_DB=pdfshush
# Only needed when the URI carries no credentials of its own.
# MONGODB_USERNAME=
# MONGODB_PASSWORD=
#
# If the boot logs report "MongoDB aborted the TLS handshake (server alert 80)",
# the cluster answered but refused to talk to this machine: Atlas's Network
# Access list does not contain its public IP. Add the IP (or 0.0.0.0/0 on a
# roaming development connection) at cloud.mongodb.com -> Network Access, then
# restart the API -- the connection is attempted only at boot.

# Google OIDC. Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and register the redirect URI
# below under "Authorized redirect URIs" -- it must match byte for byte,
# including scheme, host and port. "Authorized JavaScript origins" is unused by
# the Authorization Code flow and can be left empty.
#
# Do not download the client-secret JSON into the repository; it is gitignored,
# but the values belong in this file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The browser-facing origin the SPA is served from. Login returns here.
WEB_ORIGIN=http://localhost:5173

# Sent verbatim as `redirect_uri`. Development default:
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/callback

# Session lifetime; also the cookie max-age and the Mongo TTL. Default 30 days.
# SESSION_TTL_MS=2592000000

# `Secure` flag on the session cookie. Defaults to on in production.
#   * Production MUST be served over https with this on. A `Secure` cookie is
#     dropped on a plain-http origin (except localhost), which looks like
#     "signed in, then signed out" -- the API logs a warning at boot for exactly
#     this combination.
#   * Set to false only for local development over http on a non-localhost host.
# SESSION_COOKIE_SECURE=true

# Per-IP ceiling on /api/auth/google/start and /api/auth/callback, per minute.
# These are the two routes that cost us work (a transaction row; an outbound
# request to Google). /api/auth/me is deliberately not throttled.
# AUTH_RATE_LIMIT_PER_MINUTE=20

# ------------------------------------------------------------ managed AI ----
#
# Off unless BOTH a model and an API key are set. Managed AI lets users without
# their own key try summarize/chat on our account, metered per subject. BYOK
# (the browser talks straight to the provider) needs none of this and is always
# available in the app.
#
# Document text DOES reach the server in managed mode -- that is the trade for
# not holding a key. Leave these blank to keep every AI call in the browser.
# AI_MANAGED_PROVIDER=openai
# AI_MANAGED_MODEL=gpt-4o-mini
# AI_MANAGED_API_KEY=
# Optional: override the endpoint (regional mirror, self-hosted gateway).
# AI_MANAGED_BASE_URL=
#
# Budgets. Defaults come from LIMITS.ai (200k/day signed in, 20k/day anonymous).
# AI_MANAGED_DAILY_TOKENS=200000
# AI_MANAGED_ANON_DAILY_TOKENS=20000
# AI_MANAGED_PER_MINUTE=6
# AI_MANAGED_MAX_OUTPUT_TOKENS=4096
