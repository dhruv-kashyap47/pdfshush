{
  "name": "pdfshush",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "predev": "node scripts/ensure-redis.mjs && pnpm --filter @pdfshush/api build",
    "dev": "pnpm --parallel --filter @pdfshush/web --filter @pdfshush/api dev",
    "build": "pnpm --filter @pdfshush/web build",
    "preview": "pnpm --filter @pdfshush/web preview",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "node tests/support/preflight.mjs && node tests/e2e/smoke.mjs",
    "test:e2e:sign": "node tests/support/preflight.mjs && node tests/e2e/sign.mjs",
    "test:e2e:text-edit": "node tests/support/preflight.mjs && node tests/e2e/text-edit.mjs",
    "test:e2e:text-model": "node tests/support/preflight.mjs && node tests/e2e/text-model.mjs",
    "test:e2e:ai": "node tests/support/preflight.mjs && node tests/e2e/ai.mjs",
    "test:e2e:ai-managed": "node tests/support/preflight.mjs && node tests/e2e/ai-managed.mjs",
    "test:e2e:plain-tools": "node tests/support/preflight.mjs && node tests/e2e/plain-tools.mjs",
    "test:e2e:next-tools": "node tests/support/preflight.mjs && node tests/e2e/next-tools.mjs",
    "test:e2e:bookmark-batch": "node tests/support/preflight.mjs && node tests/e2e/bookmark-batch.mjs",
    "test:e2e:forms-bookmarks": "node tests/support/preflight.mjs && node tests/e2e/forms-bookmarks.mjs",
    "test:e2e:dark-mode": "node tests/support/preflight.mjs && node tests/e2e/dark-mode.mjs",
    "test:bundle": "node tests/bundle-boundary.mjs",
    "test:sweep": "node tests/support/preflight.mjs && node tests/sweep.mjs",
    "test:api": "node tests/api/smoke.mjs",
    "test:hardening": "node tests/api/hardening.mjs",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down",
    "redis:up": "docker compose up -d redis"
  },
  "devDependencies": {
    "mongodb": "^7.7.0",
    "playwright": "^1.63.0"
  }
}
