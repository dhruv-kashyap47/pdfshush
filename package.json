{
  "name": "pdfshush",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @pdfshush/web dev",
    "dev:web": "pnpm --filter @pdfshush/web dev",
    "dev:edge": "pnpm --filter @pdfshush/edge dev",
    "dev:full": "pnpm build && pnpm --parallel --filter @pdfshush/web --filter @pdfshush/edge dev",
    "build": "pnpm --filter @pdfshush/web build",
    "deploy": "pnpm build && node scripts/check-deploy-config.mjs && npx wrangler deploy",
    "test:deploy-config": "node scripts/check-deploy-config.mjs",
    "preview": "pnpm --filter @pdfshush/web preview",
    "db:local": "pnpm --filter @pdfshush/edge db:local",
    "db:remote": "pnpm --filter @pdfshush/edge db:remote",
    "dev:session": "node scripts/dev-session.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "node tests/support/preflight.mjs && node tests/e2e/smoke.mjs",
    "test:e2e:sign": "node tests/support/preflight.mjs && node tests/e2e/sign.mjs",
    "test:e2e:text-edit": "node tests/support/preflight.mjs && node tests/e2e/text-edit.mjs",
    "test:e2e:text-model": "node tests/support/preflight.mjs && node tests/e2e/text-model.mjs",
    "test:e2e:text-ux": "node tests/support/preflight.mjs && node tests/e2e/text-ux.mjs",
    "test:e2e:ai": "node tests/support/preflight.mjs && node tests/e2e/ai.mjs",
    "test:e2e:plain-tools": "node tests/support/preflight.mjs && node tests/e2e/plain-tools.mjs",
    "test:e2e:next-tools": "node tests/support/preflight.mjs && node tests/e2e/next-tools.mjs",
    "test:e2e:bookmark-batch": "node tests/support/preflight.mjs && node tests/e2e/bookmark-batch.mjs",
    "test:e2e:offline": "node tests/e2e/offline.mjs",
    "test:e2e:reach": "node tests/e2e/reach.mjs",
    "test:e2e:a11y": "node tests/e2e/a11y.mjs",
    "test:e2e:account-avatar": "node tests/e2e/account-avatar.mjs",
    "test:e2e:seo": "node tests/e2e/seo-smoke.mjs",
    "test:e2e:keyboard": "node tests/e2e/keyboard.mjs",
    "test:e2e:cross-browser": "node tests/support/preflight.mjs && node tests/e2e/cross-browser.mjs",
    "test:e2e:editor-touch": "node tests/support/preflight.mjs && node tests/e2e/editor-touch.mjs",
    "test:e2e:editor-unmount": "node tests/e2e/editor-unmount.mjs",
    "test:e2e:editor-cancel": "node tests/e2e/editor-cancel-save.mjs",
    "test:e2e:editor-parity": "node tests/support/preflight.mjs && node tests/e2e/editor-quick-parity.mjs",
    "test:e2e:editor-rail": "node tests/support/preflight.mjs && node tests/e2e/editor-rail.mjs",
    "test:e2e:signature-upload": "node tests/support/preflight.mjs && node tests/e2e/signature-upload.mjs",
    "test:e2e:stale-build": "node tests/e2e/stale-build.mjs",
    "test:e2e:verify": "node tests/e2e/verify.mjs",
    "test:e2e:forms-bookmarks": "node tests/support/preflight.mjs && node tests/e2e/forms-bookmarks.mjs",
    "test:e2e:dark-mode": "node tests/support/preflight.mjs && node tests/e2e/dark-mode.mjs",
    "test:e2e:deskew": "node tests/support/preflight.mjs && node tests/e2e/deskew.mjs",
    "test:e2e:ocr": "node tests/support/preflight.mjs && node tests/e2e/ocr.mjs",
    "test:e2e:sprint6": "node tests/support/preflight.mjs && node tests/e2e/sprint6-trust.mjs",
    "test:bundle": "node tests/bundle-boundary.mjs",
    "test:guardrails": "node tests/guardrails.mjs && node tests/guardrails.mjs --self-test",
    "test:provenance": "node scripts/check-provenance.mjs",
    "deps:licenses": "node scripts/gen-third-party-licenses.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "seo:lengths": "node --experimental-strip-types scripts/seo-lengths.mjs",
    "test:corpus": "node scripts/corpus.mjs",
    "test:fuzz": "pnpm --filter @pdfshush/pdf-core test:fuzz",
    "test:baseline": "node tests/benchmarks/m5-0-baseline.mjs",
    "test:perf": "node tests/benchmarks/m5-4-ceilings.mjs",
    "test:editor-perf": "pnpm --filter @pdfshush/pdf-core exec vitest run test/editorBench.test.ts --reporter=verbose",
    "test:sweep": "node tests/support/preflight.mjs && node tests/sweep.mjs"
  },
  "devDependencies": {
    "@dodopayments/opencode-plugin": "^0.8.0",
    "axe-core": "^4.14.0",
    "playwright": "^1.63.0"
  }
}
