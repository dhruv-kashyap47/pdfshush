{
  "name": "pdfshush",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @pdfshush/web dev",
    "build": "pnpm --filter @pdfshush/web build",
    "preview": "pnpm --filter @pdfshush/web preview",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "test:api": "node tests/api/smoke.mjs",
    "test:hardening": "node tests/api/hardening.mjs",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}